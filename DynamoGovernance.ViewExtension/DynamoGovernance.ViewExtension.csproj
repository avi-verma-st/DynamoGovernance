<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
	  <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="3.0.3.7597" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamoGovernance.Core\DynamoGovernance.Core.csproj" />
  </ItemGroup>

  <Target Name="DeployViewExtension" AfterTargets="Build">
    <PropertyGroup>
      <DynamoPackageDirectory Condition="'$(DynamoPackageDirectory)' == ''">C:\DynamoDev\packages\DynamoGovernance</DynamoPackageDirectory>
    </PropertyGroup>

    <MakeDir Directories="$(DynamoPackageDirectory)\bin" />
    <MakeDir Directories="$(DynamoPackageDirectory)\extra" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(DynamoPackageDirectory)\bin" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(DynamoPackageDirectory)\bin"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\DeploymentFiles\DynamoGovernance_ViewExtensionDefinition.xml"
          DestinationFolder="$(DynamoPackageDirectory)\extra" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\DeploymentFiles\pkg.json"
      DestinationFolder="$(DynamoPackageDirectory)" />
  </Target>

  <Target Name="ValidateViewExtensionDeployment"
          AfterTargets="DeployViewExtension">
    <PropertyGroup>
      <ViewExtensionAssemblyFile>$(DynamoPackageDirectory)\bin\DynamoGovernance.ViewExtension.dll</ViewExtensionAssemblyFile>
      <ViewExtensionManifestFile>$(DynamoPackageDirectory)\extra\DynamoGovernance_ViewExtensionDefinition.xml</ViewExtensionManifestFile>
    </PropertyGroup>

    <Error Condition="!Exists('$(ViewExtensionAssemblyFile)')"
           Text="Deployment validation failed: missing $(ViewExtensionAssemblyFile)" />
    <Error Condition="!Exists('$(ViewExtensionManifestFile)')"
           Text="Deployment validation failed: missing $(ViewExtensionManifestFile)" />

    <XmlPeek XmlInputPath="$(ViewExtensionManifestFile)"
             Query="/ViewExtensionDefinition/AssemblyPath/text()"
             Condition="Exists('$(ViewExtensionManifestFile)')">
      <Output TaskParameter="Result"
              PropertyName="DeployedViewExtensionAssemblyPath" />
    </XmlPeek>

    <Error Condition="'$(DeployedViewExtensionAssemblyPath)' != '..\bin\DynamoGovernance.ViewExtension.dll'"
           Text="Deployment validation failed: View Extension manifest AssemblyPath is '$(DeployedViewExtensionAssemblyPath)'; expected '..\bin\DynamoGovernance.ViewExtension.dll'." />

    <Message Text="View Extension deployment validation succeeded: $(DynamoPackageDirectory)"
             Importance="high" />
  </Target>

</Project>
