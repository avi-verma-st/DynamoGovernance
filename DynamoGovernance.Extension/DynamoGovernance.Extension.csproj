<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>2.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamoVisualProgramming.Core" Version="3.0.3.7597" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamoGovernance.Core\DynamoGovernance.Core.csproj" />
  </ItemGroup>

  <!-- Post-build event to copy DLLs to Dynamo dev packages -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Message Text="Copying DynamoGovernance extension to deployment location..." Importance="high" />
    <Exec Command="xcopy /Y /I &quot;$(TargetPath)&quot; &quot;C:\DynamoDev\packages\DynamoGovernance\bin\&quot;" ContinueOnError="true" />
    <Exec Command="xcopy /Y /I &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;C:\DynamoDev\packages\DynamoGovernance\bin\&quot;" ContinueOnError="true" />
    <Exec Command="xcopy /Y /I &quot;$(TargetDir)DynamoGovernance.Core.dll&quot; &quot;C:\DynamoDev\packages\DynamoGovernance\bin\&quot;" ContinueOnError="true" />
    <Exec Command="xcopy /Y /I &quot;$(TargetDir)DynamoGovernance.Core.pdb&quot; &quot;C:\DynamoDev\packages\DynamoGovernance\bin\&quot;" ContinueOnError="true" />
    <Message Text="DynamoGovernance extension copied successfully!" Importance="high" />
  </Target>

  <Target Name="DeployTelemetryExtension" AfterTargets="Build">
    <PropertyGroup>
      <DynamoPackageDirectory Condition="'$(DynamoPackageDirectory)' == ''">C:\DynamoDev\packages\DynamoGovernance</DynamoPackageDirectory>
    </PropertyGroup>

    <MakeDir Directories="$(DynamoPackageDirectory)\bin" />
    <MakeDir Directories="$(DynamoPackageDirectory)\extra" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DynamoPackageDirectory)\bin" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DynamoPackageDirectory)\bin" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(TargetDir)DynamoGovernance.Core.dll" DestinationFolder="$(DynamoPackageDirectory)\bin" />
    <Copy SourceFiles="$(TargetDir)DynamoGovernance.Core.pdb" DestinationFolder="$(DynamoPackageDirectory)\bin" Condition="Exists('$(TargetDir)DynamoGovernance.Core.pdb')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\DeploymentFiles\DynamoGovernance_ExtensionDefinition.xml" DestinationFolder="$(DynamoPackageDirectory)\extra" />
  </Target>

</Project>
